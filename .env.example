# This is a client-side portfolio. Never place a secret in frontend code —
# only the server-side /api functions below may read these.

# Required for the AI-powered portfolio assistant (api/chat.ts).
# Set the real value in Vercel: Project Settings -> Environment Variables.
# For local testing with `vercel dev`, put it in a git-ignored .env.local instead.
OPENAI_API_KEY=

# Optional, defaults to gpt-4o-mini.
OPENAI_MODEL=
